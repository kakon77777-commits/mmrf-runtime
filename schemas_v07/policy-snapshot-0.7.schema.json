{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMRF Policy Snapshot 0.7",
  "type": "object",
  "required": [
    "schema",
    "policy_version",
    "active_nodes",
    "revoked_nodes",
    "allowed_measurements",
    "witness_threshold",
    "previous_snapshot_sha256",
    "issued_at",
    "expires_at",
    "signature_ed25519",
    "snapshot_sha256"
  ],
  "properties": {
    "schema": {
      "const": "mmrf-policy-snapshot-0.7"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "rsa_target_endpoint": {
      "const": false
    },
    "factor_candidate_endpoint": {
      "const": false
    },
    "range_narrowing_endpoint": {
      "const": false
    }
  },
  "additionalProperties": true
}