{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MMRF Scientific Query Language 0.8",
  "type": "object",
  "required": [
    "version",
    "operation"
  ],
  "properties": {
    "version": {
      "const": "MMRF-SQL-0.8"
    },
    "operation": {
      "enum": [
        "dataset_metadata",
        "interval_density",
        "gap_quantiles",
        "gap_histogram",
        "residue_distribution",
        "family_counts",
        "workflow_replay"
      ]
    },
    "shard_start": {
      "type": "integer",
      "minimum": 0
    },
    "shard_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "modulo": {
      "enum": [
        6,
        30,
        210
      ]
    },
    "quantiles": {
      "type": "array",
      "items": {
        "enum": [
          0.5,
          0.9,
          0.95,
          0.99
        ]
      }
    },
    "gap_max": {
      "type": "integer",
      "minimum": 16,
      "maximum": 2048
    },
    "workflow_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}